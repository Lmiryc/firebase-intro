{
  "name": "firebase-tour",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:infrastructure": "jest --runInBand --testPathPattern=infrastructure",
    "check-progress": "node scripts/check-progress.js",
    "check-progress:report": "node scripts/check-progress.js --report-only",
    "verify": "npm run check-progress && npm test"
  },
  "dependencies": {
    "expo": "~52.0.46",
    "expo-status-bar": "~2.0.1",
    "firebase": "^11.4.0",
    "react": "18.3.1",
    "react-native": "0.76.9"
  },
  "devDependencies": {
    "@babel/parser": "^7.26.10",
    "@babel/traverse": "^7.26.10",
    "@testing-library/react-native": "^13.0.1",
    "babel-jest": "^29.7.0",
    "babel-preset-expo": "~12.0.11",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.6",
    "react-test-renderer": "18.3.1"
  }
}
